{
  "name": "exactly-once",
  "version": "0.1.0",
  "description": "Exactly-once, domain-checked commits for AI agent actions. Agents propose. The database decides.",
  "license": "MIT",
  "author": "Alejandro Alvarado (roddcode) <roddcode.dev@gmail.com>",
  "homepage": "https://roddcode.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roddcode/exactly-once.git"
  },
  "keywords": [
    "ai-agents",
    "exactly-once",
    "idempotency",
    "agent-actions",
    "postgres",
    "llm",
    "transactions"
  ],
  "packageManager": "pnpm@11.1.3",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "check": "biome check --write .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:db": "vitest run --config vitest.db.config.ts --no-file-parallelism",
    "test:coverage": "vitest run --config vitest.db.config.ts --no-file-parallelism --coverage",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "validate:package": "publint && attw --pack ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.1",
    "pg": "^8.23.0",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
